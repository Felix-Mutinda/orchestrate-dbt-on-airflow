# ==========================================
# Runtime Environment
# ==========================================
# Defines the active environment config (local, dev, staging, prod)
ENV_NAME=local

# ==========================================
# Airflow Configuration
# ==========================================
# CRITICAL for Docker Compose on Windows/Linux: ensures mounted ./var volumes 
# have the correct ownership (matches the airflow user in the Dockerfile).
AIRFLOW_UID=50000

# Airflow home directory. 
# Note: docker-compose.yml overrides this to /opt/airflow for the containers.
# For native local execution fallback, this points to the local var directory.
AIRFLOW_HOME=./var/airflow

AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True

# SQLite DB for Airflow metadata. 
# CRITICAL: Docker containers require ABSOLUTE paths for SQLite. 
# Do not use relative paths (e.g., sqlite:///./var/...) here, or Airflow will crash on startup.
# The path below matches the internal container mount point defined in docker-compose.yml.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/var/airflow/airflow.db

# ==========================================
# dbt Configuration
# ==========================================
DBT_PROFILES_DIR=./dbt_project
DBT_TARGET=local
DBT_SELECT=state:modified+

# ==========================================
# Warehouse Configuration (Local: DuckDB)
# ==========================================
WAREHOUSE_TYPE=duckdb
DUCKDB_PATH=./var/duckdb/feature_platform.duckdb

# ==========================================
# Feast Configuration
# ==========================================
FEAST_REPO_PATH=./feast_repo
FEAST_REGISTRY_PATH=./var/feast/registry.db
FEAST_ONLINE_STORE_TYPE=sqlite
FEAST_ONLINE_STORE_PATH=./var/feast/online_store.db

# ==========================================
# Dataset Configuration
# ==========================================
DATASET_NAME=nyc_tlc_yellow
# Latest available full month (May 2026)
DATASET_MONTH=2026-05
# Set to empty/null to process the FULL dataset.
# Leaving this empty demonstrates DuckDB's vectorized performance locally.
# If you ever need to test with a subset, set this to a number (e.g., 250000).
DATASET_SAMPLE_ROWS=
RAW_DATA_PATH=./var/data/yellow_tripdata_2026-05.parquet

# ==========================================
# Secrets / Production Overrides
# ==========================================
# In local dev, these are empty or point to local files.
# In prod, these are injected via Vault / AWS Secrets Manager / CI secrets.
# The DAG/config loader will fall back to local paths if these are empty.
WAREHOUSE_DSN=
FEAST_ONLINE_STORE_CONNECTION=